// Pin Definitions
const int buttonPin = 2; // Pin connected to the pushbutton
const int motorPin = 3;  // Pin connected to the transistor base/gate

// Variables
int buttonState = 0;     // Variable to store the button status

void setup() {
  pinMode(motorPin, OUTPUT);    // Set the motor control pin as an output
  pinMode(buttonPin, INPUT);    // Set the button pin as an input
}

void loop() {
  // Read the state of the pushbutton
  buttonState = digitalRead(buttonPin);

  // If the button is pressed, turn the motor ON
  if (buttonState == HIGH) {
    digitalWrite(motorPin, HIGH); 
  } else {
    // If the button is released, turn the motor OFF
    digitalWrite(motorPin, LOW);  
  }
}
